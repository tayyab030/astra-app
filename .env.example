# local | production
# Use "local" to hit your Nest backend on this machine / LAN.
EXPO_PUBLIC_MODE=local

# Point the app at the Astra backend API (required for Assistant).
# Phone/emulator on same Wi‑Fi: use your PC LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.100.58:3001/api

# Production example:
# EXPO_PUBLIC_MODE=production
# EXPO_PUBLIC_API_BASE_URL=https://astra-backend-48lg.onrender.com/api
