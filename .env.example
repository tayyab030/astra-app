# local | production
# Use "local" to hit the machine running Expo (LAN IP / Android emulator).
EXPO_PUBLIC_MODE=production

# Optional override. If unset, mode picks the URL automatically.
# Local frontend uses http://localhost:3001/api
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3001/api

# Groq Console API key (https://console.groq.com)
# Used by the in-app Assistant. Prefer proxying via your backend in production.
CONSOLE_GROQ_API_KEY=your_groq_api_key_here
